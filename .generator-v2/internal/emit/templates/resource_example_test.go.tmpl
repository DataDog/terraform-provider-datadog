{{- define "resource_example_test" -}}
// {{ .Marker }}
//
// Every value in the configuration below was declared by the OpenAPI
// description: an example, or a schema default. Nothing here was invented. A
// description that could not supply a required value produces no test at all,
// so there is no such thing as a partly-guessed one — see the cassette entry
// in the run report for the source anchors.
//
// The cassette this replays is recorded, not generated: run with RECORD=true
// to record it against a real org, RECORD=false to replay it. A recording run
// may be rejected by the API, since the values here are examples and
// placeholders rather than real credentials.
package test

import (
	"context"
	"fmt"
	{{ if .UsesStrconv }}"strconv"{{ end }}
	{{ if .UsesTime }}"time"{{ end }}
	"testing"

	{{ if .UsesUUID }}"github.com/google/uuid"{{ end }}
	"github.com/hashicorp/terraform-plugin-testing/helper/resource"
	"github.com/hashicorp/terraform-plugin-testing/terraform"
{{ if .UsesSDK }}
	// The destroy check uses an SDK constructor or a named SDK argument type.
	"github.com/DataDog/datadog-api-client-go/v2/api/{{ .SDKPackage }}"
{{- end }}
	"github.com/terraform-providers/terraform-provider-datadog/datadog/fwprovider"
)

func {{ .FuncName }}(t *testing.T) {
	// Skips before any provider setup. The configuration below comes from the
	// description's own examples, so a recording run may still be rejected by
	// the API — an example can be stale or a placeholder, and that is the
	// expected way to learn the description is wrong. Replay needs a cassette
	// recorded first.
	if !isRecording() && !isReplaying() {
		t.Skip("{{ .FuncName }} needs RECORD=true to record a cassette, or RECORD=false to replay one")
	}
	t.Parallel()
	_, providers, accProviders := testAccFrameworkMuxProviders(context.Background(), t)

	resource.Test(t, resource.TestCase{
		ProtoV6ProviderFactories: accProviders,
		CheckDestroy:             {{ .DestroyCheckFunc }}(providers.frameworkProvider),
		Steps: []resource.TestStep{
{{- range $index, $step := .Steps }}
			{
				Config: {{ $step.ConfigFunc }}(),
				Check: resource.ComposeTestCheckFunc(
{{- range $step.Checks }}
					{{ . }},
{{- end }}
				),
			},
{{- end }}
		},
	})
}

{{ range .Steps }}
func {{ .ConfigFunc }}() string {
	return {{ .ConfigLiteral }}
}
{{ end }}
// {{ .DestroyCheckFunc }} confirms the object is gone. Unlike the checks above,
// which read state, this one asks the API — the cassette's final interaction is
// a read expecting a 404, and this is what consumes it.
//
// A read that succeeds means destroy left the object behind, so it is an error.
// A check that cannot fail would be worse than no check, because it looks like
// coverage.
func {{ .DestroyCheckFunc }}(accProvider *fwprovider.FrameworkProvider) resource.TestCheckFunc {
	return func(s *terraform.State) error {
		apiInstances := accProvider.DatadogApiInstances
		auth := accProvider.Auth

		for _, r := range s.RootModule().Resources {
			if r.Type != "{{ .ResourceType }}" {
				continue
			}
{{- with .ReadArgument }}
{{- if .ParsedVar }}
			{{ .ParsedVar }}, err := {{ .ParseCall }}
			if err != nil {
				return fmt.Errorf("invalid resource id for destroy check: %w", err)
			}
{{- end }}
{{- end }}
{{- if .APIAccessor }}
			_, httpResp, err := apiInstances.{{ .APIAccessor }}().{{ .ReadMethod }}(auth, {{ .ReadArgument.Expression }})
{{- else }}
			api := {{ .SDKPackage }}.{{ .APIConstructor }}(apiInstances.HttpClient)
			_, httpResp, err := api.{{ .ReadMethod }}(auth, {{ .ReadArgument.Expression }})
{{- end }}
			if err != nil {
				if httpResp != nil && httpResp.StatusCode == 404 {
					continue
				}
				return fmt.Errorf("error retrieving {{ .ResourceType }} %s: %w", r.Primary.ID, err)
			}
			return fmt.Errorf("{{ .ResourceType }} %s still exists after destroy", r.Primary.ID)
		}
		return nil
	}
}
{{- end -}}
