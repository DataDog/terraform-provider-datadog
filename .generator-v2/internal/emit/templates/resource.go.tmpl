{{/*
  commitState maps resp into state via updateState and, absent a diagnostic
  error, writes state back. Shared by Create, Read and Update, each
  of which has already declared "resp", "state", "ctx" and "response" by the
  point it includes this.
*/}}
{{- define "commitState" -}}
	response.Diagnostics.Append(r.updateState(ctx, &state, &resp)...)
	if response.Diagnostics.HasError() {
		return
	}
{{ template "normalizeUnknowns" .NormalizeUnknowns }}
	response.Diagnostics.Append(response.State.Set(ctx, &state)...)
{{- end -}}

{{/* normalizeUnknowns prevents computed plan placeholders that a sparse
response omitted from reaching final Create state. */}}
{{- define "normalizeUnknowns" -}}
{{- range . }}
{{- if eq .Kind "value" }}
	if {{ .Expr }}.IsUnknown() {
		{{ .Expr }} = {{ .NullExpr }}
	}
{{- else if eq .Kind "object" }}
	if {{ .Expr }} != nil {
{{ template "normalizeUnknowns" .Children }}
	}
{{- else if eq .Kind "list_object" }}
	for _, {{ .ItemVar }} := range {{ .Expr }} {
		if {{ .ItemVar }} != nil {
{{ template "normalizeUnknowns" .Children }}
		}
	}
{{- end }}
{{- end }}
{{- end -}}

{{/*
  decodePlan first preserves the complete Terraform value in a Framework
  object, then converts it into the generated native model. Computed-only
  nested values may legitimately be unknown during Create/Update; native
  pointer structs cannot represent that state, so they remain empty until the
  API response overlays them. Framework value fields continue to retain their
  own null and unknown states.
*/}}
{{- define "decodePlan" -}}
	var plan types.Object
	response.Diagnostics.Append(request.Plan.Get(ctx, &plan)...)
	if response.Diagnostics.HasError() {
		return
	}
	response.Diagnostics.Append(plan.As(ctx, &state, basetypes.ObjectAsOptions{UnhandledUnknownAsEmpty: true})...)
	if response.Diagnostics.HasError() {
		return
	}
{{- end -}}

{{/*
  writeOnlySecretResults retrieves write-only values from configuration before
  any request body is constructed. GetterCall is role-specific; the shared
  package-scoped configuration keeps schema and lifecycle routing aligned.
*/}}
{{- define "writeOnlySecretResults" -}}
{{- range . }}
	{{ .HandlerVar }} := fwutils.WriteOnlySecretHandler{
		Config:                 {{ .ConfigVar }},
		SecretRequiredOnUpdate: {{ .RequiredOnUpdate }},
	}
	{{ .ResultVar }} := {{ .HandlerVar }}.{{ .GetterCall }}
	response.Diagnostics.Append({{ .ResultVar }}.Diagnostics...)
	if response.Diagnostics.HasError() {
		return
	}
{{- end }}
{{- end -}}

{{/*
  requestBody builds one role's JSON:API request body a level at a time, each
  level from its own New<Type>WithDefaults(). Innermost first, so every level
  is populated before the level above takes it by value:

      bodyAttributes := pkg.New<Attrs>WithDefaults()   // request fields set here
      bodyData       := pkg.New<Data>WithDefaults()
      bodyData.SetType(pkg.<TypeEnum>("<value>"))     // the JSON:API discriminator
      bodyData.SetId(...)                             // update only; a create has no id
      bodyData.SetAttributes(*bodyAttributes)
      body           := pkg.New<Request>WithDefaults()
      body.SetData(*bodyData)

  The wrapper's own constructor cannot stand in for the inner ones: it returns
  the zero struct, so reaching through it leaves "type" empty — which the API
  rejects — and panics where the wrapper declares Data as a pointer. Create and
  Update construct different SDK types, so each renders its own envelope.
*/}}
{{- define "requestBody" -}}
{{- $requestType := .GoRequestType }}
{{- with .Envelope }}
{{- with .IDPrep }}
{{ template "argParse" . }}
{{- end }}
{{- if .AttributesType }}
	{{ requestAttributesVar }} := {{ .SDKPackage }}.New{{ .AttributesType }}WithDefaults()
{{ template "requestFields" .Fields }}
{{- end }}
	{{ .DataVar }} := {{ .SDKPackage }}.New{{ .DataType }}WithDefaults()
{{- with .TypeExpr }}
	{{ $.Envelope.DataVar }}.SetType({{ . }})
{{- end }}
{{- with .IDExpr }}
	{{ $.Envelope.DataVar }}.SetId({{ . }})
{{- end }}
{{- if .AttributesType }}
	{{ .DataVar }}.SetAttributes(*{{ requestAttributesVar }})
{{- end }}
	body := {{ .SDKPackage }}.New{{ $requestType }}WithDefaults()
	body.SetData(*{{ .DataVar }})
{{- end }}
{{- end -}}

{{/*
  requestFields renders the Set<Field>(...) calls that populate one role's
  constructed attributes local, guarding every non-Required field on
  null/unknown. Required fields are sent unconditionally: the framework
  guarantees a plan value for them.
*/}}
{{- define "requestFields" -}}
{{- range . }}
{{ template "requestField" . }}
{{- end }}
{{- end -}}

{{/*
  requestField renders one Set<Field>(...) call on .Target, precomputed per
  field because a nested field's template execution cannot see its ancestors.
  Nested builds its own SDK value and recurses through its Fields; Collection
  converts or constructs a list/map first; a leaf with ParsedVar parses
  fallibly; anything else converts directly. A union renders its own guard, so
  it is tested first; the rest share one presence guard.
*/}}
{{- define "requestField" -}}
{{- if .OneOf }}
	if {{ .NullCheck }} {
{{ template "requestOneOfValue" .OneOf }}
		{{ .Target }}.Set{{ .GoField }}({{ .OneOf.Var }})
	}{{ if .Required }} else {
		response.Diagnostics.AddError(
			{{ printf "Invalid %s" .OneOf.TFName | printf "%q" }},
			fmt.Sprintf({{ printf "%q" .OneOf.SelectionMessage }}, 0),
		)
		return
	}{{ end }}
{{- else if .WriteOnlyResult }}
	if {{ .WriteOnlyResult }}.ShouldSetValue {
		{{ .Target }}.Set{{ .GoField }}({{ .WriteOnlyResult }}.Value)
	}
{{- else if .Required }}
{{ template "requestFieldBody" . }}
{{- else }}
	if {{ .NullCheck }} {
{{ template "requestFieldBody" . }}
	}
{{- end }}
{{- end -}}

{{/*
  requestFieldBody is the field's mapping itself, with no presence guard. An
  optional field is the same body inside "if <not null or unknown>", so
  requestField renders this once and wraps it; gofmt fixes up the indentation
  either way, which is why one body serves both.
*/}}
{{- define "requestFieldBody" -}}
{{- if .Nested }}
	{{ .Nested.Var }} := {{ .Nested.Constructor }}
{{- range .Nested.Fields }}
{{ template "requestField" . }}
{{- end }}
	{{ .Target }}.Set{{ .GoField }}(*{{ .Nested.Var }})
{{- else if .Collection }}
{{ template "requestCollectionValue" . }}
	{{ .Target }}.Set{{ .GoField }}({{ .Collection.ConvertVar }})
{{- else if .ParsedVar }}
	{{ .ParsedVar }}, err := {{ .ParseCall }}
	if err != nil {
		response.Diagnostics.AddError("Invalid {{ .TFName }}", err.Error())
		return
	}
	{{ .Target }}.Set{{ .GoField }}({{ .ValueExpr }})
{{- else }}
	{{ .Target }}.Set{{ .GoField }}({{ .ValueExpr }})
{{- end }}
{{- end -}}

{{/*
  requestCollectionValue leaves .Collection.ConvertVar holding the value a
  collection field's Set<Field> call takes. "primitive" decodes state's
  types.List/types.Map into a native Go slice or map via ElementsAs; "object"
  builds one request element per already-decoded state element in a loop.
*/}}
{{- define "requestCollectionValue" -}}
{{- if eq .Collection.Kind "primitive" }}
	var {{ .Collection.ConvertVar }} {{ .Collection.ConvertType }}
	response.Diagnostics.Append({{ .Collection.ConvertCall }}...)
	if response.Diagnostics.HasError() {
		return
	}
{{- else }}
	var {{ .Collection.ConvertVar }} []{{ .Collection.ElementGoType }}
	for _, {{ .Collection.LoopVar }} := range {{ .Collection.RangeExpr }} {
		{{ .Collection.ElemVar }} := {{ .Collection.Constructor }}
{{- range .Collection.Fields }}
{{ template "requestField" . }}
{{- end }}
		{{ .Collection.ConvertVar }} = append({{ .Collection.ConvertVar }}, *{{ .Collection.ElemVar }})
	}
{{- end }}
{{- end -}}

{{/*
  requestOneOfValue leaves .Var holding the SDK oneOf wrapper a union field's
  Set<Field> call takes. It renders inside the caller's "if <envelope> != nil"
  block, so its locals are scoped to that envelope. Every variant is inspected
  and the selections counted, then exactly one is required, checked before the
  SDK call so an invalid selection costs no request. An object alternative
  builds its member with New<Member>WithDefaults() and fills it through
  requestField; a value-wrapped one converts its single "value" child.
*/}}
{{- define "requestOneOfValue" -}}
	var {{ .Var }} {{ .SDKType }}
	{{ .MatchVar }} := 0
{{- range .Variants }}
	if {{ .ModelExpr }} != nil {
{{- if .Value }}
{{- if .Value.ParsedVar }}
		{{ .Value.ParsedVar }}, err := {{ .Value.ParseCall }}
		if err != nil {
			response.Diagnostics.AddError({{ printf "Invalid %s" .Value.TFName | printf "%q" }}, err.Error())
			return
		}
{{- end }}
		{{ .ElemVar }} := {{ .Value.ValueExpr }}
{{- else }}
		{{ .ElemVar }} := {{ .Constructor }}
{{- range .Fields }}
{{ template "requestField" . }}
{{- end }}
{{- end }}
		{{ $.Var }} = {{ .WrapCall }}
		{{ $.MatchVar }}++
	}
{{- end }}
	if {{ .MatchVar }} != 1 {
		response.Diagnostics.AddError(
			{{ printf "Invalid %s" .TFName | printf "%q" }},
			fmt.Sprintf({{ printf "%q" .SelectionMessage }}, {{ .MatchVar }}),
		)
		return
	}
{{- end -}}
