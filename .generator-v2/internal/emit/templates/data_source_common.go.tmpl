{{/*
  Shared partials for the data-source templates. These define the pieces that
  are identical between the singular and plural shapes: the Go model structs,
  the recursive schema attribute/block rendering, and the type / constructor /
  Configure / Metadata boilerplate.

  Whitespace here is intentionally loose: every rendered file is run through
  go/format, which fixes all indentation and trailing space. Templates only
  need to emit syntactically valid Go.
*/}}

{{/* modelStructs renders every Go struct in .Models, parent first. */}}
{{- define "modelStructs" -}}
{{- range .Models }}
type {{ .Name }} struct {
{{- range .Fields }}
{{- if .Comment }}

	// {{ .Comment }}
{{- end }}
	{{ .GoField }} {{ .GoType }} `tfsdk:"{{ .TFName }}"`
{{- end }}
}

{{ end }}
{{- end -}}

{{/* schemaAttribute renders one leaf schema.*Attribute entry. */}}
{{- define "schemaAttribute" -}}
"{{ .TFName }}": {{ .TFType }}{
	Description: {{ printf "%q" .Description }},
{{- if .ElementType }}
	ElementType: {{ .ElementType }},
{{- end }}
{{- template "presenceFlags" . }}
{{- template "validators" . }}
{{ template "planModifiers" . }}
},
{{- end -}}

{{/*
  presenceFlags renders the Required/Optional/Computed/Sensitive fields shared
  by a leaf attribute and both nested-attribute forms. Only the flags that are
  set are emitted, so a data source's computed-only attribute stays as terse as
  it was hand-written.
*/}}
{{- define "presenceFlags" -}}
{{- if .Required }}
	Required: true,
{{- end }}
{{- if .Optional }}
	Optional: true,
{{- end }}
{{- if .Computed }}
	Computed: true,
{{- end }}
{{- if .Sensitive }}
	Sensitive: true,
{{- end }}
{{- end -}}

{{/*
  planModifiers renders the "PlanModifiers: [...]" field shared by a leaf and
  a nested attribute. Resource attributes only — a data source's AttrView
  always carries an empty PlanModifiers, so this renders nothing there.
*/}}
{{- define "planModifiers" -}}
{{- if .PlanModifiers }}
	PlanModifiers: []planmodifier.{{ .PlanModifierType }}{
{{- range .PlanModifiers }}
		{{ . }}(),
{{- end }}
	},
{{- end }}
{{- end -}}

{{/*
  validators renders the "Validators: []validator.<T>{...}" field for a leaf or
  a nested object attribute; ValidatorType names the element type, so one
  partial serves both.
*/}}
{{- define "validators" -}}
{{- if .Validators }}
	Validators: []validator.{{ .ValidatorType }}{
{{- range .Validators }}
		{{ . }},
{{- end }}
	},
{{- end }}
{{- end -}}

{{/* nestedBody renders one combined Attributes map for a nested attribute. */}}
{{- define "nestedBody" -}}
{{- if or .Attributes .Blocks }}
Attributes: map[string]schema.Attribute{
{{- range .Attributes }}
{{ template "schemaAttribute" . }}
{{- end }}
{{- range .Blocks }}
{{ template "schemaNestedAttribute" . }}
{{- end }}
},
{{- end }}
{{- end -}}

{{/* schemaNestedAttribute renders one nested attribute recursively. */}}
{{- define "schemaNestedAttribute" -}}
{{- if .ListBlock }}
"{{ .TFName }}": schema.ListNestedAttribute{
	Description: {{ printf "%q" .Description }},
	NestedObject: schema.NestedAttributeObject{
{{ template "nestedBody" . }}
	},
{{- template "presenceFlags" . }}
{{ template "validators" . }}
{{ template "planModifiers" . }}
},
{{- else }}
"{{ .TFName }}": schema.SingleNestedAttribute{
	Description: {{ printf "%q" .Description }},
{{ template "nestedBody" . }}
{{- template "presenceFlags" . }}
{{ template "validators" . }}
{{ template "planModifiers" . }}
},
{{- end }}
{{- end -}}

{{/*
  updateStateBody is the body of a state mapper: it projects the already-decoded
  response into state, returning diagnostics rather than writing them so it stays
  free of the request/response types and can fail at a specific schema path.

  Shared by the singular data source's updateState and the resource's, which
  differ only in the receiver and model type their signature names — so each root
  spells its own signature and delegates the body here.
*/}}
{{- define "updateStateBody" -}}
	var diags diag.Diagnostics
{{- range .State.Preamble }}
	{{ . }}
{{- end }}
{{- range .State.Assignments }}
	if {{ .Var }}, ok := {{ .GetterOk }}; ok && {{ .Var }} != nil {
		{{ .LHS }} = {{ .RHS }}
	}
{{- end }}
{{- range .State.Lists }}
	{{ template "renderList" . }}
{{- end }}
	return diags
{{- end -}}

{{/*
  renderList projects one SDK collection into state. The primitive branch reports
  the conversion's own diagnostics instead of discarding them, and converts under
  the caller's ctx: a state mapper has no business minting context.Background(),
  and a failed ListValueFrom used to leave a zero value in state silently. Each
  branch opens its own `if` block, so the block-scoped listDiags cannot collide
  with a sibling or nested list.
*/}}
{{- define "renderList" -}}
{{- if eq .Kind "primitive" -}}
if {{ .Var }}, ok := {{ .GetterOk }}; ok && {{ .Var }} != nil {
	var collectionDiags diag.Diagnostics
	{{- if eq .ContainerKind "map" }}
	{{ .LHS }}, collectionDiags = types.MapValueFrom(ctx, {{ .ElementType }}, *{{ .Var }})
	{{- else }}
	{{ .LHS }}, collectionDiags = types.ListValueFrom(ctx, {{ .ElementType }}, *{{ .Var }})
	{{- end }}
	diags.Append(collectionDiags...)
} else {
	{{- if eq .ContainerKind "map" }}
	{{ .LHS }} = types.MapNull({{ .ElementType }})
	{{- else }}
	{{ .LHS }} = types.ListNull({{ .ElementType }})
	{{- end }}
}
{{- else if eq .Kind "object" -}}
if {{ .Var }}, ok := {{ .GetterOk }}; ok && {{ .Var }} != nil {
	{{- if .PreserveExisting }}
	{{ .ExistingVar }} := {{ .LHS }}
	{{ .LHS }} = nil
	for {{ .LoopIndex }}, {{ .LoopVar }} := range *{{ .Var }} {
		{{ .ElemVar }} := &{{ .ElemStruct }}{}
		if len({{ .ExistingVar }}) > {{ .LoopIndex }} && {{ .ExistingVar }}[{{ .LoopIndex }}] != nil {
			{{ .ElemVar }} = {{ .ExistingVar }}[{{ .LoopIndex }}]
		}
	{{- else }}
	for _, {{ .LoopVar }} := range *{{ .Var }} {
		{{ .ElemVar }} := &{{ .ElemStruct }}{}
	{{- end }}
{{- range .Scalars }}
		if {{ .Var }}, ok := {{ .GetterOk }}; ok && {{ .Var }} != nil {
			{{ .LHS }} = {{ .RHS }}
		}
{{- end }}
{{- range .Lists }}
		{{ template "renderList" . }}
{{- end }}
		{{ .LHS }} = append({{ .LHS }}, {{ .ElemVar }})
	}
}
{{- else if eq .Kind "object_single" -}}
if {{ .Var }}, ok := {{ .GetterOk }}; ok && {{ .Var }} != nil {
	{{- if .PreserveExisting }}
	{{ .ElemVar }} := {{ .LHS }}
	if {{ .ElemVar }} == nil {
		{{ .ElemVar }} = &{{ .ElemStruct }}{}
	}
	{{- else }}
	{{ .ElemVar }} := &{{ .ElemStruct }}{}
	{{- end }}
{{- range .Scalars }}
	if {{ .Var }}, ok := {{ .GetterOk }}; ok && {{ .Var }} != nil {
		{{ .LHS }} = {{ .RHS }}
	}
{{- end }}
{{- range .Lists }}
	{{ template "renderList" . }}
{{- end }}
	{{ .LHS }} = {{ .ElemVar }}
}
{{- else if eq .Kind "oneof" -}}
{{ template "renderOneOf" .OneOf }}
{{- end }}
{{- end -}}

{{/*
  renderOneOf unwraps one SDK oneOf wrapper into its Terraform envelope model.

  Every member is inspected and the matches counted; the envelope is only assigned
  when exactly one matched. This is deliberately not the SDK's own behaviour —
  MarshalJSON and GetActualInstance both return the first non-nil member — because
  the contract requires zero, multiple, or an unparsed payload to be reported at the
  union's schema path rather than silently resolving to one branch.

  The wrapper itself is reached through an ordinary Ok-getter; only its members are
  plain fields, which is why they are read with `:=` rather than Get<Field>Ok.
*/}}
{{- define "renderOneOf" -}}
if {{ .Var }}, ok := {{ .GetterOk }}; ok && {{ .Var }} != nil {
{{- if .Collection }}
	{{- if .PreserveExisting }}
	{{ .ExistingVar }} := {{ .LHS }}
	{{ .LHS }} = nil
	for {{ .LoopIndex }}, {{ .LoopVar }} := range *{{ .Var }} {
	{{- else }}
	for _, {{ .LoopVar }} := range *{{ .Var }} {
	{{- end }}
		{{ template "oneOfBody" . }}
	}
{{- else }}
	{{ template "oneOfBody" . }}
{{- end }}
}
{{- end -}}

{{/*
  oneOfBody selects at most one variant off .Receiver and reports anything
  ambiguous. Split from renderOneOf so the collection and single forms share it.
*/}}
{{- define "oneOfBody" -}}
{{ .ModelVar }} := &{{ .GoModel }}{}
{{ .MatchVar }} := 0
{{- range .Variants }}
if {{ .SDKVar }} := {{ $.Receiver }}.{{ .SDKField }}; {{ .SDKVar }} != nil {
	{{ .ModelVar }} := &{{ .GoModel }}{}
	{{- if $.PreserveExisting }}
	{{- if $.Collection }}
	if len({{ $.ExistingVar }}) > {{ $.LoopIndex }} && {{ $.ExistingVar }}[{{ $.LoopIndex }}] != nil && {{ $.ExistingVar }}[{{ $.LoopIndex }}].{{ .GoField }} != nil {
		{{ .ModelVar }} = {{ $.ExistingVar }}[{{ $.LoopIndex }}].{{ .GoField }}
	}
	{{- else }}
	if {{ $.LHS }} != nil && {{ $.LHS }}.{{ .GoField }} != nil {
		{{ .ModelVar }} = {{ $.LHS }}.{{ .GoField }}
	}
	{{- end }}
	{{- end }}
{{- with .Value }}
	{{ .LHS }} = {{ .RHS }}
{{- end }}
{{- range .Scalars }}
	if {{ .Var }}, ok := {{ .GetterOk }}; ok && {{ .Var }} != nil {
		{{ .LHS }} = {{ .RHS }}
	}
{{- end }}
{{- range .Lists }}
	{{ template "renderList" . }}
{{- end }}
	{{ $.ModelVar }}.{{ .GoField }} = {{ .ModelVar }}
	{{ $.MatchVar }}++
}
{{- end }}
switch {
case {{ .Receiver }}.UnparsedObject != nil:
	diags.AddError(
		"unexpected {{ .SDKType }} in the API response",
		"{{ .Path }}: the Datadog API returned a value none of the {{ .SDKType }} alternatives could parse",
	)
case {{ .MatchVar }} > 1:
	diags.AddError(
		"ambiguous {{ .SDKType }} in the API response",
		fmt.Sprintf("{{ .Path }}: the Datadog API response matched %d {{ .SDKType }} alternatives, expected exactly one", {{ .MatchVar }}),
	)
case {{ .MatchVar }} == 1:
	{{ if .Collection }}{{ .LHS }} = append({{ .LHS }}, {{ .ModelVar }}){{ else }}{{ .LHS }} = {{ .ModelVar }}{{ end }}
{{- if not .Optional }}
default:
	diags.AddError(
		"missing {{ .SDKType }} in the API response",
		"{{ .Path }}: the Datadog API response matched none of the {{ .SDKType }} alternatives, and the field is not optional",
	)
{{- end }}
}
{{- end -}}

{{/* boilerplate renders the data-source struct, constructor, Configure, Metadata. */}}
{{- define "boilerplate" -}}
type {{ .GoName }}DataSource struct {
	Api  *{{ .SDKPackage }}.{{ .APIStruct }}
	Auth context.Context
}

func New{{ title .GoName }}DataSource() datasource.DataSource {
	return &{{ .GoName }}DataSource{}
}

func (d *{{ .GoName }}DataSource) Configure(_ context.Context, request datasource.ConfigureRequest, response *datasource.ConfigureResponse) {
	providerData, _ := request.ProviderData.(*FrameworkProvider)
{{- if .APIAccessor }}
	d.Api = providerData.DatadogApiInstances.{{ .APIAccessor }}()
{{- else }}
	d.Api = {{ .SDKPackage }}.{{ .APIConstructor }}(providerData.DatadogApiInstances.HttpClient)
{{- end }}
	d.Auth = providerData.Auth
}

func (d *{{ .GoName }}DataSource) Metadata(_ context.Context, request datasource.MetadataRequest, response *datasource.MetadataResponse) {
	response.TypeName = "{{ .TypeName }}"
}
{{- end -}}

{{/*
  argParse declares the local for ONE SDK call argument or query filter that must
  be recovered by parsing (a uuid- or integer-typed value behind a Terraform
  string), and bails with a diagnostic when it does not parse. Defined over a
  single item rather than a slice so it serves both the argument sites, which
  range, and the filter sites, which are already inside a per-filter range —
  SDKArgumentView and FilterParamView both carry the ParsedVar/ParseCall/TFName
  trio it reads. Renders nothing when no parse is needed; go/format fixes the
  indentation, so the same body serves a nested call site too.
*/}}
{{- define "argParse" -}}
{{- if .ParsedVar }}
	{{ .ParsedVar }}, err := {{ .ParseCall }}
	if err != nil {
		response.Diagnostics.AddError("Invalid {{ .TFName }}", err.Error())
		return
	}
{{- end }}
{{- end -}}

{{/* argPrep applies argParse across a whole argument slice. */}}
{{- define "argPrep" -}}
{{- range . }}{{ template "argParse" . }}{{ end }}
{{- end -}}
